# Entornos virtuales de Python
backend/.venv/
**/__pycache__/
*.pyc

# Datos y modelos generados en tiempo de ejecución (no son código fuente)
backend/data/

# Caché de pytest
backend/.pytest_cache/
backend/.mypy_cache/
backend/data/modelos/

# Configuración local
.env

# Docker
*.log

# Editores / SO
.DS_Store
Thumbs.db

# Reportes de CI generados localmente
backend/pytest-report.xml
backend/benchmarks/*.json
backend/reporte*.json
frontend/e2e/*.json
backend/disponibilidad*.csv

# Terraform (infra/terraform): proveedores descargados, estado y variables locales
infra/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
backend_override.tf

# Reportes de calidad y seguridad generados localmente
backend/coverage.xml
backend/.coverage
semgrep*.json
semgrep*.sarif
snyk*.json
snyk*.sarif
